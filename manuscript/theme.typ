// Colours and dimensions shared by the layout and the figures.
#let ow-orange = rgb("#E36C0A")   // accent: the high leg, rules, numbers
#let ink = rgb("#1F2328")         // body text and line work
#let grey = rgb("#6B7280")        // captions, notes, running header
#let hair = rgb("#C9CDD2")        // hairline rules
#let tint = rgb("#F3F4F6")        // table header tint

#let margin-col = 34mm            // left column for captions and margin notes
#let gutter = 6mm                 // gap between columns
